# Default locale per `dotnet run`.
# In produzione imposta esplicitamente `ASPNETCORE_ENVIRONMENT=Production`.
ASPNETCORE_ENVIRONMENT=Development
APP_DB_URL=jdbc:mysql://localhost:3306/soccerdreamfermana?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
FRONTEND_BASE_URL=https://yourdomain.com
APP_JWT_SECRET=replace_with_at_least_32_characters_or_base64_secret
ADMIN_NAME=Admin soccerdream
ADMIN_EMAIL=admin@soccerdream.it
ADMIN_PASSWORD=replace_admin_password_here

INSTAGRAM_TOKEN=your_instagram_token_here
FACEBOOK_API_VERSION=v23.0
FACEBOOK_POST_LIMIT=12
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here

PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_CURRENCY=EUR

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL_ENABLE=false
APP_MAIL_FROM=noreply@example.com
APP_CONTACT_MAIL_FROM=contact@example.com
APP_MAIL_CONTACT_TO=contact@example.com
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_SCAN_INTERVAL_MINUTES=60
